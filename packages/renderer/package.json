{
  "name": "@thethoughtagen/fieldnotes-renderer",
  "version": "0.1.0",
  "description": "Shared Markdown rendering contract for FIELDNOTES documents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheThoughtagen/fieldnotes-editor.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/TheThoughtagen/fieldnotes-editor#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:conformance && npm run build:types && npm run build:node && npm run build:browser && npm run build:css",
    "build:test": "npm run clean && npm run build:types && npm run build:node && npm run build:browser && npm run build:css",
    "build:conformance": "node scripts/build-conformance.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "build:node": "esbuild src/index.ts src/conformance.ts --bundle --packages=external --platform=node --format=esm --target=node24 --outdir=dist",
    "build:browser": "esbuild src/browser.ts --bundle --platform=browser --format=esm --target=safari17 --outfile=dist/browser.js",
    "build:css": "cp src/styles.css dist/styles.css",
    "pretest": "npm run build:test",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/styles.css",
    "fixtures"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "github-slugger": "2.0.0",
    "katex": "0.18.7",
    "mermaid": "12.0.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
