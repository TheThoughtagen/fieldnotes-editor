{
  "modes": ["normal", "insert", "replace"],
  "motions-basic": ["h", "j", "k", "l"],
  "motions-word": ["w", "W", "b", "B", "e", "E"],
  "motions-line": ["0", "^", "$"],
  "motions-document": ["gg", "G"],
  "motions-find": ["f", "F", "t", "T", ";", ","],
  "motions-pairs": ["%"],
  "motions-blocks": ["{", "}", "(", ")"],
  "motions-screen": ["H", "M", "L"],
  "motions-scroll": ["Ctrl-f", "Ctrl-b", "Ctrl-d", "Ctrl-u"],
  "operator-delete": ["d{motion}"],
  "operator-change": ["c{motion}"],
  "operator-yank": ["y{motion}"],
  "operator-counts": ["{count}{operator}{motion}"],
  "operator-double": ["dd", "cc", "yy"],
  "text-words": ["iw", "aw", "iW", "aW"],
  "text-sentences": ["is", "as"],
  "text-paragraphs": ["ip", "ap"],
  "text-pairs": ["i(", "a(", "i[", "a[", "i{", "a{", "i<", "a<"],
  "text-quotes": ["i\"", "a\"", "i'", "a'", "i`", "a`"],
  "text-tags": ["it", "at"],
  "edits-insert": ["i", "a", "I", "A"],
  "edits-open": ["o", "O"],
  "edits-replace": ["r", "R", "s", "S"],
  "edits-delete": ["x", "X", "C", "D"],
  "edits-lines": ["J"],
  "edits-repeat": ["."],
  "edits-undo": ["u", "Ctrl-r"],
  "edits-case": ["~"],
  "edits-indent": ["<<", ">>", "="],
  "registers": ["\"a", "\"_", "\"+", "\"*"],
  "put": ["p", "P"],
  "marks": ["m{letter}", "'{letter}", "`{letter}"],
  "macros": ["q{register}", "@{register}", "@@"],
  "search-pattern": ["/pattern", "?pattern"],
  "search-repeat": ["n", "N"],
  "search-word": ["*", "#"],
  "ex-substitute": [":s"],
  "ex-substitute-all": [":%s"],
  "ex-set": ["ignorecase", "smartcase", "hlsearch"],
  "ex-nohlsearch": [":noh"],
  "native-write": [":write", ":w"],
  "native-quit": [":quit", ":q"],
  "visual-character": ["v", "vld"],
  "visual-line": ["V", "Vjd"],
  "visual-block": ["Ctrl-v", "Ctrl-v jld"],
  "unsupported-shell": [":!"],
  "unsupported-vimscript": [":source", ":function", ":let"],
  "unsupported-map": [":map", ":nmap", ":imap", ":vmap"],
  "unsupported-file": [":edit", ":read", ":file"],
  "unsupported-buffer": [":buffer", ":bnext", ":bdelete"],
  "unsupported-window": [":split", ":vsplit", ":tabnew", ":close"],
  "unsupported-force": [":q!", ":w!", ":wq", ":x"],
  "unsupported-write-path": [":write {path}"]
}
